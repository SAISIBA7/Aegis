# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://aegis:aegispassword@localhost:5432/aegis"

# Redis (matches docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# BullMQ Provisioning Worker Concurrency (default: 5)
WORKER_CONCURRENCY=5

# NVIDIA NIM API — added in Phase 4, placeholder for now
NVIDIA_NIM_API_KEY=""
NVIDIA_NIM_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
